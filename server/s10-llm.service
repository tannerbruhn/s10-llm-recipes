[Unit]
Description=S10 LLM router (our llama.cpp fork: Ornith 1.5 9B M5+MTP default, Ornith 1.0 9B, Bonsai 27B with GPU assist; OpenAI API, no web UI)
After=network-online.target s10-cpucap.service s10-thermal-guard.service s10-gpu-cap.service
# Never serve without the thermal guard: Wants= starts it, the ExecStartPre check refuses to start without it,
# and s10-guard-failed.service stops this unit if the guard stays down. (Not Requires=: systemd would restart
# the LLM, and kill a running answer, every time the guard's watchdog restarts it.)
Wants=network-online.target s10-thermal-guard.service

[Service]
User=user
Group=user
# The GPU assist only touches PTQ1_0 weights (the 27B); Ornith never opens OpenCL.
Environment=LD_LIBRARY_PATH=/home/user/llama-mali/build-mali/bin
Environment=OCL_ICD_VENDORS=/home/user/mesa-idp/vendors RUSTICL_ENABLE=panfrost GGML_OPENCL_PLATFORM=0
# 27B: the GPU computes 30% of each PTQ1_0 matrix (re-swept 2026-11-19 with server/frac-sweep.sh: 0.25-0.35 within
# noise); the CPU's rows run as int2 (about +0.6 GB of RAM). The pool line is optional: it needs the s10cpumem module
# (setup/cpumem/) and puts the first 184 MB of the int2 data into the modem carve-out; without the device it is skipped.
# Ornith is not affected. Re-sweep after kernel, clock or cooling changes (s10-frac-check warns at start).
Environment=GGML_S10_GPU_FRAC=0.30 GGML_S10_GPU_MINMB=6
Environment=GGML_S10_INT2=all GGML_S10_INT2_POOL=/dev/s10cpumem GGML_S10_INT2_POOL_MB=184
# 27B with MTP on one phone: lock its small file-backed weights so the page cache cannot evict them (only acts on
# PTQ1_0 models; without it MTP re-read them from flash on every token).
Environment=GGML_S10_MLOCK_SMALL=1
LimitMEMLOCK=infinity
# Requests with no or an unknown "model" go to the default model, as with the old single-model server (fork patch).
Environment=LLAMA_ROUTER_DEFAULT_MODEL=ornith-1.5-9b
# GPU at Samsung's stock 702 MHz while serving (the governor does not ramp for the bursty assist, so pin it;
# the GPU runtime-suspends when idle). Back to the boot cap of 433 MHz on stop.
# Warns in the journal when build or clocks differ from what the GPU share was tuned for (server/s10-frac-check).
ExecStartPre=-/usr/local/sbin/s10-frac-check
ExecStartPre=/usr/sbin/systemctl is-active --quiet s10-thermal-guard.service
ExecStartPre=+/bin/sh -c 'D=/sys/class/devfreq/18500000.gpu; echo 156000000 > $D/min_freq; echo 702000000 > $D/max_freq; echo 702000000 > $D/min_freq'
ExecStart=/home/user/llama-mali/build-mali/bin/llama-server \
  --models-preset /etc/s10-llm/s10-models.ini --models-max 1 \
  --host 0.0.0.0 --port 8080 --no-webui \
  --api-key-file /etc/s10-llm/api-key
ExecStopPost=+/bin/sh -c 'D=/sys/class/devfreq/18500000.gpu; echo 156000000 > $D/min_freq; echo 433000000 > $D/max_freq'
# The thermal guard freezes this unit's cgroup (and SIGSTOPs llama-*) when hot.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
